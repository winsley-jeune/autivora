<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.autivora.daily-signal</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/jeunewinsley/.local/share/fnm/aliases/default/bin/node</string>
    <string>/Users/jeunewinsley/Developer/nextjs-shopify/agents/scripts/scheduler.mjs</string>
  </array>

  <!-- The code scheduler owns timing, catch-up, deduplication, and bounded retries. launchd only
       keeps that control process alive across terminal closure, crashes, logout, and restart. -->
  <key>KeepAlive</key>
  <true/>

  <!-- launchd-level stderr/stdout, separate from the script's own dated log file — this catches
       failures that happen before the script's own logging even starts (e.g. the script itself
       failing to execute). -->
  <key>StandardOutPath</key>
  <string>/Users/jeunewinsley/Library/Logs/autivora-agents/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jeunewinsley/Library/Logs/autivora-agents/launchd.err.log</string>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
