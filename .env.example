# =============================================================================
# Autivora — environment variables
# Copy values into Vercel (Production scope) before deployment.
# Empty values leave the relevant feature disabled — site still builds and runs.
# =============================================================================

# ---- Shopify Storefront API (REQUIRED — site cannot fetch products without these) ----
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ---- Site base URL (REQUIRED for canonical URLs, JSON-LD, sitemap) ----
NEXT_PUBLIC_BASE_URL=https://autivara.com

# ---- Sanity CMS (optional — falls back to lib/mock-db.ts if blank) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# =============================================================================
# Analytics & ad pixels — leave blank to keep dormant.
# Paste IDs after creating the accounts in each platform.
# =============================================================================

# Google Analytics 4 — format: G-XXXXXXXXXX
# Create at: https://analytics.google.com
NEXT_PUBLIC_GA4_ID=

# Meta (Facebook + Instagram) Pixel — numeric ID
# Create at: https://business.facebook.com → Events Manager → Connect Data Source → Web
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel — alphanumeric ID
# Create at: https://ads.tiktok.com → Tools → Events → Web Events → Set up
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Pinterest Tag — numeric ID
# Create at: https://ads.pinterest.com → Conversions → Tag Manager
NEXT_PUBLIC_PINTEREST_TAG_ID=

# =============================================================================
# Site verification — for Search Console & ad platforms.
# Paste the content="..." value from each platform's HTML meta tag method.
# =============================================================================

# Google Search Console — content from <meta name="google-site-verification" content="..."/>
# https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools — content from <meta name="msvalidate.01" content="..."/>
# https://www.bing.com/webmasters
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Yandex Webmaster — content from <meta name="yandex-verification" content="..."/>
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Meta Business Manager — domain verification meta tag
# https://business.facebook.com → Brand Safety → Domains → Verify
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=

# Pinterest site verification — content from <meta name="p:domain_verify" content="..."/>
NEXT_PUBLIC_PINTEREST_SITE_VERIFICATION=

# TikTok site verification (optional)
NEXT_PUBLIC_TIKTOK_SITE_VERIFICATION=

# =============================================================================
# Analytics agent (agents/analytics/) — server-side data pulls for the growth loop's
# MEASURE stage. Leave blank to keep the agent dormant. Setup: agents/analytics/README.md
# =============================================================================

# Absolute path to a Google service-account JSON key. Keep this file OUTSIDE the repo.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Search Console property URL, exact match — e.g. https://autivara.com/ or sc-domain:autivara.com
GSC_SITE_URL=

# GA4 numeric property ID — GA4 Admin → Property Settings
GA4_PROPERTY_ID=

# Shopify Admin API — analytics agent's sales pull (order count, revenue, AOV, top products,
# revenue by day). Deliberately a SEPARATE app from product-pipeline's app (that one is
# read/write_products for catalog sync; this one is read-only order access).
# This store's app platform is the Dev Dashboard (dev.shopify.com), which only issues
# short-lived tokens via OAuth client credentials — not a classic static token. Setup via the
# Shopify CLI: see agents/analytics/README.md.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Comma-separated emails for your own/friend/family checkout-flow test purchases. Shopify's
# `test` flag only covers actual test-mode orders, not real checkouts you ran yourself — list
# those emails here so Signal doesn't read them as market/demand signal. Optional, blank is fine.
SIGNAL_TEST_CUSTOMER_EMAILS=

# Content image generation (blog headers, product lifestyle shots) — gpt-image-2 via the
# standard OpenAI Images API. Pay-per-use billing, ~$0.02-$0.21/image depending on size/quality.
# Create at: https://platform.openai.com → Billing (add payment method) → API keys → Create key.
OPENAI_API_KEY=

# =============================================================================
# Signal agent (agents/signal/) — the growth loop's analyst/decision stage. Reads the
# analytics agent's snapshot, scores its own past task check-backs, and emits today's
# prioritized task queue for the CTR/Uplift/Linker/etc. agents. Never publishes anything
# itself. Requires the analytics agent's env vars above PLUS this one. Setup: agents/signal/README.md
# =============================================================================

# Local AI is the default. Install Ollama, run `ollama pull qwen3.5:9b`, and keep its service
# running. Signal inputs are compacted for a measured 48K context on a 24 GB Apple Silicon Mac.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_TOKENS=49152
OLLAMA_TIMEOUT_MS=1200000

# Optional hosted fallback. Set AI_PROVIDER=anthropic to use it; otherwise no Anthropic key is
# required. Scout/Envoy use the existing DATAFORSEO_API_KEY for grounded live SERP and Shopping
# evidence; without that key, those research stages pause instead of guessing.
ANTHROPIC_API_KEY=
ANTHROPIC_GENERATOR_MODEL=claude-sonnet-4-6
ANTHROPIC_VERIFIER_MODEL=claude-opus-4-8
AI_DAILY_BUDGET_USD=2.00
AI_MONTHLY_BUDGET_USD=15.00
CATALOG_VERIFY_MAX_CANDIDATES=6

# =============================================================================
# NOTES
# - Every variable prefixed with NEXT_PUBLIC_ is shipped to the browser.
#   Do not put server-only secrets behind that prefix.
# - Server-only vars (SHOPIFY_STOREFRONT_ACCESS_TOKEN, SANITY_API_TOKEN) stay
#   on the server — safe to commit only the names, never the values.
# - When you populate a pixel/verification ID in Vercel, redeploy to apply.
# =============================================================================
